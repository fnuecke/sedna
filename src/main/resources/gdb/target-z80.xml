<?xml version="1.0"?>
<!DOCTYPE target SYSTEM "gdb-target.dtd">
<target version="1.0">
    <architecture>z80</architecture>
    <osabi>none</osabi>
    <feature name="org.gnu.gdb.z80.cpu">
        <flags id="af_flags" size="2">
            <field name="C" start="0" end="0"/>
            <field name="N" start="1" end="1"/>
            <field name="P/V" start="2" end="2"/>
            <field name="F3" start="3" end="3"/>
            <field name="H" start="4" end="4"/>
            <field name="F5" start="5" end="5"/>
            <field name="Z" start="6" end="6"/>
            <field name="S" start="7" end="7"/>
            <field name="A" start="8" end="15"/>
        </flags>
        <reg name="af" bitsize="16" type="af_flags"/>
        <reg name="bc" bitsize="16"/>
        <reg name="de" bitsize="16"/>
        <reg name="hl" bitsize="16"/>
        <reg name="sp" bitsize="16" type="data_ptr"/>
        <reg name="pc" bitsize="16" type="code_ptr"/>
        <reg name="ix" bitsize="16"/>
        <reg name="iy" bitsize="16"/>
        <reg name="af'" bitsize="16" type="af_flags"/>
        <reg name="bc'" bitsize="16"/>
        <reg name="de'" bitsize="16"/>
        <reg name="hl'" bitsize="16"/>
        <reg name="ir" bitsize="16"/>
    </feature>
    <feature name="li.cil.sedna.z80.state">
        <reg name="im" bitsize="8"/>
        <reg name="iff1" bitsize="8"/>
        <reg name="iff2" bitsize="8"/>
    </feature>
</target>
